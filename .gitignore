# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# Local tool state, editor configuration and private credentials
/.agents/
/.codex/
/.aws/
/.ssh/
/.vscode/
/.idea/
/.openai/*
!/.openai/hosting.json
.dev.vars*
*.tsbuildinfo
*.key
*.p12
*.pfx
*.jks
*.keystore
*.log
Thumbs.db
